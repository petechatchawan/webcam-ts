{
  "name": "webcam-ts",
  "version": "4.0.0-alpha.1",
  "description": "Framework-agnostic TypeScript camera session library for modern browsers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "import": "./dist/preview/index.js"
    },
    "./capture": {
      "types": "./dist/capture/index.d.ts",
      "import": "./dist/capture/index.js"
    },
    "./devices": {
      "types": "./dist/devices/index.d.ts",
      "import": "./dist/devices/index.js"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run typecheck && npm test"
  },
  "license": "MIT",
  "author": "Pete Chatchawan",
  "repository": {
    "type": "git",
    "url": "https://github.com/petechatchawan/webcam-ts.git"
  },
  "homepage": "https://github.com/petechatchawan/webcam-ts#readme",
  "bugs": {
    "url": "https://github.com/petechatchawan/webcam-ts/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "webcam",
    "camera",
    "typescript",
    "getusermedia",
    "mediastream",
    "webrtc",
    "capture",
    "ssr"
  ],
  "devDependencies": {
    "@types/node": "^24.0.7",
    "typescript": "^5.0.0"
  }
}
