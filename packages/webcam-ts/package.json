{
	"name": "webcam-ts",
	"version": "3.4.7",
	"description": "Modern TypeScript library for webcam access in web applications",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist/**/*",
		"README.md"
	],
	"keywords": [
		"webcam",
		"camera",
		"typescript",
		"webrtc",
		"mediastream",
		"video",
		"capture",
		"permissions",
		"device-detection",
		"callback-api",
		"modern",
		"angular",
		"torch",
		"capabilities"
	],
	"author": "Pete Chatchawan",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/petechatchawan/webcam-ts.git"
	},
	"homepage": "https://webcam-ts-docs.vercel.app/",
	"bugs": {
		"url": "https://github.com/petechatchawan/webcam-ts/issues"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc",
		"typecheck": "tsc --noEmit",
		"lint": "npm run typecheck",
		"test": "npm run build && node --test test/webcam.test.mjs",
		"prepare": "npm run build",
		"prepublishOnly": "npm run lint && npm run test"
	},
	"devDependencies": {
		"@types/node": "^24.0.7",
		"typescript": "^5.0.0"
	}
}
