{
	"name": "webcam-ts-monorepo",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"test": "pnpm --dir packages/webcam-ts test && pnpm --dir apps/playground test",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"dev:playground": "turbo run dev --filter=playground",
		"start:playground": "pnpm --dir apps/playground dev:https",
		"verify:playground": "node scripts/verify-playground-clean-room.mjs"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@8.14.0",
	"devDependencies": {
		"prettier": "2.8.8",
		"turbo": "2.5.4"
	}
}
