{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"for (const path of ['dist','dist-test']) require('fs').rmSync(path,{recursive:true,force:true})\"",
    "dev": "pnpm --dir ../../packages/webcam-ts build && vite --host 0.0.0.0",
    "typecheck": "pnpm --dir ../../packages/webcam-ts build && tsc -p tsconfig.json --noEmit",
    "build": "pnpm --dir ../../packages/webcam-ts build && vite build",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "pnpm --dir ../../packages/webcam-ts build && npm run clean && npm run build:test && node --test --test-concurrency=1 test/*.test.mjs",
    "pretest:browser": "pnpm --dir ../../packages/webcam-ts build",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium",
    "test:browser:firefox": "playwright test --project=firefox",
    "test:browser:webkit": "playwright test --project=webkit"
  },
  "dependencies": {
    "webcam-ts": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.7",
    "typescript": "~5.8.0",
    "vite": "^6.1.0"
  }
}
